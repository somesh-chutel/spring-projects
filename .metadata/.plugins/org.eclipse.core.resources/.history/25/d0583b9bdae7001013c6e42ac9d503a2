package com.demo.controller;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PatchMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.demo.entity.Student;
import com.demo.entity.repo.StudentRepo;

@RestController
@RequestMapping("/student")
public class StudentController {
	
	@Autowired
	private StudentRepo repo;
	
	@PostMapping("/save")
	Student saveStudent(@RequestBody Student student) {
		
		repo.save(student);
		
		return student;
	}
	
	
	@PostMapping("/saveall")
	List<Student> saveAllStudent(@RequestBody List<Student> student){
		
		repo.saveAll(student);
		
		return student;
	}
	
	
	@GetMapping("/get/{id}")
	Optional<Student> getStudent(@PathVariable("id") int stuid) {
		
		Optional<Student> student = repo.findById(stuid).get();
		
		System.out.println(student);
		
		return student;
	}
	
//	@GetMapping("/get")
//	Student getStudent(@RequestParam("id") int stuid) {
//		
//		Student student = repo.findById(stuid).get();
//		
//		return student;
//	}
	
	
	@GetMapping("/getall")
	List<Student> getAllStudent(){
		
		List<Student> student = repo.findAll();
		
		return student;
		
	}
	
	@PutMapping("/update/{id}")
	Student updateStudent(@PathVariable("id") int stuid,@RequestBody Student student) {
		
		Student myStudent = repo.findById(stuid).get();
		
		myStudent.setAge(student.getAge());
		myStudent.setGender(student.getGender());
		myStudent.setName(student.getName());
		
		repo.save(myStudent);
		
		return myStudent;
		
	}
	
	
	@PatchMapping("/uni/update/{id}/{age}")
	Student updateSpecData(@PathVariable("id") int stuid,@PathVariable("age") int stuAge) {
		
		Student myStudent = repo.findById(stuid).get();
		
		myStudent.setAge(stuAge);
		
		repo.save(myStudent);
		
		return myStudent;
	}

}
